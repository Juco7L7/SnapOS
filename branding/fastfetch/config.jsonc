{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/snapos/logo.txt",
    "color": { "1": "red" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": ": ",
    "color": { "keys": "red", "title": "red", "separator": "red" }
  },
  "modules": [
    { "type": "title", "color": { "user": "red", "host": "red" } },
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Resolution" },
    { "type": "de", "key": "DE" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk" },
    { "type": "command", "key": "Security", "text": "echo 'ClamAV + snapguard'" },
    { "type": "command", "key": "Init", "text": "cat /proc/1/comm 2>/dev/null || echo runit" },
    "break",
    "colors"
  ],
  "modulesByDefault": false
}
